# Copy to .env.local. NEXT_PUBLIC_* values are exposed to the browser; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173
# Server-side only. Origin of the API that the website proxies /api/* to (defaults to http://localhost:4000), and the API URL used by server-rendered pages.
# API_ORIGIN=http://localhost:4000
# API_URL=http://localhost:4000/api
