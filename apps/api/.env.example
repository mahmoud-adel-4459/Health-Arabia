# Copy to .env. Development-only values; must match the root .env used by docker-compose.yml.
PORT=4000
DATABASE_URL=postgresql://healtharabia:healtharabia@localhost:5432/healtharabia?schema=public
# Allowed browser origins (website and dashboard). Required in production; also the CSRF origin allow-list for state-changing requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
# NODE_ENV=production in production. Only "development"/"test" allow the built-in admin fallback; elsewhere ADMIN_EMAIL and a real ADMIN_PASSWORD (12+ chars) are required.
# NODE_ENV=development
# Number of reverse proxies in front of the API (1 behind the Next.js rewrite or a single load balancer). Needed for correct per-client rate limiting.
# TRUST_PROXY=1
# Uploaded private files. Development default: ./private-storage. PRODUCTION: required, an absolute persistent path OUTSIDE the Git checkout and the API directory (the API refuses to start otherwise).
# PRIVATE_STORAGE_PATH=
